{
  "extends": "./.nuxt/tsconfig.json",
  "include": [
    ".nuxt/nuxt.d.ts",
    "app/**/*",
    "app/**/*.vue",
    "shared/**/*",
    "shared/**/*.vue",
    "server/**/*",
    "nuxt.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    ".data"
  ],
  "vueCompilerOptions": {
    "plugins": [
      "vue-router/volar/sfc-route-blocks"
    ]
  }
}
